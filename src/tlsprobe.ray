//! The certificate chain a TLS server presents. `std/net` only exposes a summary of the leaf
//! (`tls_peer_cert`: subject, issuer, dates, SANs — no DER, no chain), so we speak just enough
//! TLS 1.2 by hand: a ClientHello, then read the server's flight up to its Certificate message,
//! which TLS 1.2 still sends in the clear. Nothing is negotiated to completion.

import std/collections/bytesbuilder as bb;
import std/crypto;
import std/net;

const CIPHER_SUITES: [int] = [
    0xc02b, 0xc02f, 0xc02c, 0xc030, 0xcca9, 0xcca8, 0xc009, 0xc013, 0xc00a, 0xc014, 0x009c,
    0x009d, 0x002f, 0x0035,
];

const SIG_ALGS: [int] = [
    0x0403, 0x0503, 0x0603, 0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601, 0x0807, 0x0203,
    0x0201,
];

fn u16(n: int) -> bytes {
    bytes_of([(n >> 8) & 0xff, n & 0xff])
}

fn u24(n: int) -> bytes {
    bytes_of([(n >> 16) & 0xff, (n >> 8) & 0xff, n & 0xff])
}

fn ext(kind: int, body: bytes) -> bytes {
    bytes_concat([u16(kind), u16(body.len()), body])
}

fn u16_list(xs: [int]) -> bytes {
    let b = bb.new();
    for x in xs {
        b.push(u16(x));
    }
    let body = b.build();
    bytes_concat([u16(body.len()), body])
}

/// A TLS 1.2 ClientHello record with SNI (omitted for an IP address).
pub fn client_hello(host: string) -> bytes {
    let exts = bb.new();
    if (!is_ip(host)) {
        let name = host.to_bytes();
        let entry = bytes_concat([bytes_of([0]), u16(name.len()), name]);
        exts.push(ext(0x0000, bytes_concat([u16(entry.len()), entry])));
    }
    exts.push(ext(0x000a, u16_list([0x001d, 0x0017, 0x0018])));
    exts.push(ext(0x000b, bytes_of([1, 0])));
    exts.push(ext(0x000d, u16_list(SIG_ALGS)));
    exts.push(ext(0x0017, bytes_of([])));
    exts.push(ext(0xff01, bytes_of([0])));
    let ext_bytes = exts.build();
    let suites = u16_list(CIPHER_SUITES);
    let body = bytes_concat([
        bytes_of([3, 3]),
        crypto.random_bytes(32),
        bytes_of([0]),
        suites,
        bytes_of([1, 0]),
        u16(ext_bytes.len()),
        ext_bytes,
    ]);
    let hs = bytes_concat([bytes_of([1]), u24(body.len()), body]);
    bytes_concat([bytes_of([22, 3, 1]), u16(hs.len()), hs])
}

fn is_ip(host: string) -> bool {
    if (host.contains(":")) {
        return true;
    }
    for c in host.chars() {
        if (!((c >= '0' && c <= '9') || c == '.')) {
            return false;
        }
    }
    true
}

/// What the server's flight told us.
pub enum Flight {
    Chain([bytes]),
    Alert(int, int),
    NotTls12(string),
}

/// Feeds the received records into a handshake buffer; returns the Certificate message's chain
/// once it is complete. Pure (no I/O) so the tests can drive it with canned records.
pub struct Reader {
    records: bytes,
    handshake: bytes,
    version_checked: bool,
}

pub fn reader() -> Reader {
    Reader { records: bytes_of([]), handshake: bytes_of([]), version_checked: false }
}

const MAX_FLIGHT: int = 1 << 20;

/// `Ok(Some(flight))` when done, `Ok(None)` when more octets are needed.
pub fn feed(r: Reader, chunk: bytes) -> Result<Option<Flight>, string> {
    r.records = bytes_concat([r.records, chunk]);
    if (r.records.len() + r.handshake.len() > MAX_FLIGHT) {
        return Result.Err("server flight larger than 1 MiB without a Certificate message");
    }
    while (r.records.len() >= 5) {
        let kind = r.records[0];
        let len = (r.records[3] << 8) | r.records[4];
        if (r.records.len() < 5 + len) {
            break;
        }
        let body = r.records.sub_bytes(5, 5 + len);
        r.records = r.records.sub_bytes(5 + len, r.records.len());
        if (kind == 21 && body.len() >= 2) {
            return Result.Ok(Option.Some(Flight.Alert(body[0], body[1])));
        }
        if (kind != 22) {
            return Result.Ok(Option.Some(Flight.NotTls12("unexpected record type ${kind} before the certificate")));
        }
        r.handshake = bytes_concat([r.handshake, body]);
        while (r.handshake.len() >= 4) {
            let mtype = r.handshake[0];
            let mlen = (r.handshake[1] << 16) | (r.handshake[2] << 8) | r.handshake[3];
            if (r.handshake.len() < 4 + mlen) {
                break;
            }
            let msg = r.handshake.sub_bytes(4, 4 + mlen);
            r.handshake = r.handshake.sub_bytes(4 + mlen, r.handshake.len());
            if (mtype == 2) {
                if (msg.len() < 2 || msg[0] != 3 || msg[1] != 3) {
                    return Result.Ok(Option.Some(Flight.NotTls12("ServerHello is not TLS 1.2")));
                }
                r.version_checked = true;
            } else if (mtype == 11) {
                if (!r.version_checked) {
                    return Result.Err("Certificate before ServerHello");
                }
                return Result.Ok(Option.Some(Flight.Chain(parse_certificate_msg(msg)?)));
            }
        }
    }
    Result.Ok(Option.None)
}

/// TLS 1.2 Certificate: `certificate_list<0..2^24-1>` of `opaque ASN.1Cert<1..2^24-1>`.
pub fn parse_certificate_msg(msg: bytes) -> Result<[bytes], string> {
    if (msg.len() < 3) {
        return Result.Err("short Certificate message");
    }
    let total = (msg[0] << 16) | (msg[1] << 8) | msg[2];
    if (total + 3 != msg.len()) {
        return Result.Err("Certificate message length mismatch");
    }
    var out: [bytes] = [];
    var off = 3;
    while (off < msg.len()) {
        if (off + 3 > msg.len()) {
            return Result.Err("truncated certificate entry");
        }
        let n = (msg[off] << 16) | (msg[off + 1] << 8) | msg[off + 2];
        if (off + 3 + n > msg.len()) {
            return Result.Err("certificate entry runs past the message");
        }
        out.push(msg.sub_bytes(off + 3, off + 3 + n));
        off = off + 3 + n;
    }
    Result.Ok(out)
}

pub fn alert_text(level: int, desc: int) -> string {
    let name = match (desc) {
        40 => "handshake_failure",
        70 => "protocol_version",
        71 => "insufficient_security",
        80 => "internal_error",
        112 => "unrecognized_name",
        _ => "alert ${desc}",
    };
    "${if (level == 2) { "fatal" } else { "warning" }} ${name}"
}

/// Connects, sends the ClientHello and returns the presented chain (leaf first).
pub fn fetch_chain(host: string, port: int, timeout_ms: int) -> Result<[bytes], string> {
    let h = net.tcp_connect_timeout(host, port, timeout_ms)?;
    net.set_read_timeout(h, timeout_ms);
    let result = exchange(h, host);
    close(h);
    result
}

fn exchange(h: int, host: string) -> Result<[bytes], string> {
    net.socket_write_bytes(h, client_hello(host))?;
    let r = reader();
    while (true) {
        let chunk = net.socket_read_bytes(h)?;
        if (chunk.len() == 0) {
            return Result.Err("connection closed before the server sent its certificate");
        }
        match (feed(r, chunk)?) {
            Option.None => {},
            Option.Some(f) => {
                return match (f) {
                    Flight.Chain(certs) => Result.Ok(certs),
                    Flight.Alert(level, desc) => Result.Err("server refused a TLS 1.2 handshake: ${alert_text(level, desc)}"),
                    Flight.NotTls12(why) => Result.Err(why),
                };
            },
        }
    }
}
